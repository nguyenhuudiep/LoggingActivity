@model LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<section class="login-page">
    <aside class="login-hero" aria-hidden="true">
        <div class="login-hero__glow login-hero__glow--one"></div>
        <div class="login-hero__glow login-hero__glow--two"></div>

        <div class="login-hero__brand">
            <img src="~/img/tima-logo.svg" alt="" />
        </div>

        <div class="login-hero__body">
            <span class="login-hero__eyebrow">Logging Activity · Admin Console</span>
            <h1 class="login-hero__title">Giám sát hoạt động hệ thống trong một màn hình.</h1>
            <p class="login-hero__text">Tiếp nhận activity log từ các hệ thống tích hợp, phát hiện bất thường theo ngưỡng cảnh báo và phân quyền truy cập rõ ràng cho đội vận hành.</p>

            <ul class="login-hero__features">
                <li>
                    <span class="login-hero__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18" /><path d="M7 15l4-4 3 3 5-6" /></svg>
                    </span>
                    <div>
                        <strong>Dashboard trực quan</strong>
                        <span>Xu hướng 7 ngày, giờ cao điểm và top action theo thời gian thực.</span>
                    </div>
                </li>
                <li>
                    <span class="login-hero__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
                    </span>
                    <div>
                        <strong>Cảnh báo chủ động</strong>
                        <span>Tự động ghi nhận khi user chạm ngưỡng action trong ngày.</span>
                    </div>
                </li>
                <li>
                    <span class="login-hero__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg>
                    </span>
                    <div>
                        <strong>Phân quyền theo nhóm</strong>
                        <span>Admin và Auditor chỉ thấy đúng những màn hình được cấp.</span>
                    </div>
                </li>
            </ul>
        </div>

        <div class="login-hero__footer">&copy; @DateTime.Now.Year Tima · Logging Activity</div>
    </aside>

    <div class="login-panel">
        <div class="login-card">
            <img class="login-card__logo" src="~/img/tima-logo.svg" alt="Tima - Vay trong ngày" />

            <div class="login-card__header">
                <h2 class="login-card__title">Đăng nhập</h2>
                <p class="login-card__subtitle">Chào mừng trở lại. Nhập tài khoản được cấp để tiếp tục.</p>
            </div>

            <form asp-action="Login" method="post" class="login-form" data-login-form novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="login-alert" role="alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg>
                        <div asp-validation-summary="ModelOnly" class="login-alert__text"></div>
                    </div>
                }

                <div class="login-field">
                    <label asp-for="UserName" class="form-label"></label>
                    <div class="login-input">
                        <svg class="login-input__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        <input asp-for="UserName" class="form-control" autocomplete="username" placeholder="Tên đăng nhập" autofocus />
                    </div>
                    <span asp-validation-for="UserName" class="login-field__error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="login-input">
                        <svg class="login-input__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Mật khẩu" />
                        <button type="button" class="login-input__toggle" data-password-toggle aria-label="Hiện mật khẩu" title="Hiện mật khẩu">
                            <svg data-eye-open viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg data-eye-closed hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 19c-6.5 0-10-7-10-7a18.45 18.45 0 0 1 5.06-5.94" /><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19" /><path d="M1 1l22 22" /></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="login-field__error"></span>
                </div>

                <div class="form-check login-remember">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary login-submit" data-login-submit>
                    <span class="login-submit__spinner" aria-hidden="true"></span>
                    <span class="login-submit__text">Đăng nhập</span>
                </button>
            </form>

            <p class="login-card__help">Quên mật khẩu hoặc chưa có tài khoản? Liên hệ quản trị viên hệ thống.</p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var toggle = document.querySelector("[data-password-toggle]");
            var password = document.getElementById("Password");
            if (toggle && password) {
                toggle.addEventListener("click", function () {
                    var show = password.type === "password";
                    password.type = show ? "text" : "password";
                    toggle.querySelector("[data-eye-open]").hidden = show;
                    toggle.querySelector("[data-eye-closed]").hidden = !show;
                    var label = show ? "Ẩn mật khẩu" : "Hiện mật khẩu";
                    toggle.setAttribute("aria-label", label);
                    toggle.title = label;
                    password.focus();
                });
            }

            var form = document.querySelector("[data-login-form]");
            var submit = document.querySelector("[data-login-submit]");
            if (form && submit) {
                form.addEventListener("submit", function () {
                    if (window.jQuery && jQuery(form).valid && !jQuery(form).valid()) {
                        return;
                    }
                    submit.classList.add("is-loading");
                    submit.disabled = true;
                });
            }
        })();
    </script>
}
