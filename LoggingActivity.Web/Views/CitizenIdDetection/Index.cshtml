            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="citizen-ocr-test-tab" data-bs-toggle="tab" data-bs-target="#citizen-ocr-test" type="button" role="tab" aria-controls="citizen-ocr-test" aria-selected="false">Test OCR</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="citizen-combined-test-tab" data-bs-toggle="tab" data-bs-target="#citizen-combined-test" type="button" role="tab" aria-controls="citizen-combined-test" aria-selected="false">Test gộp Detect + OCR</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="citizen-detect-doc-tab" data-bs-toggle="tab" data-bs-target="#citizen-detect-doc" type="button" role="tab" aria-controls="citizen-detect-doc" aria-selected="false">Mô tả công nghệ</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="citizen-api-doc-tab" data-bs-toggle="tab" data-bs-target="#citizen-api-doc" type="button" role="tab" aria-controls="citizen-api-doc" aria-selected="false">Thông tin tích hợp API</button>
            </li>
        </ul>

        <div class="tab-content" id="citizenDetectTabsContent">
            <div class="tab-pane fade show active" id="citizen-detect-test" role="tabpanel" aria-labelledby="citizen-detect-test-tab" tabindex="0">
                <form id="citizenIdDetectForm" class="row g-3 align-items-end mb-3">
                    <div class="col-lg-10 col-md-12">
                        <label class="form-label" for="citizenImage">Ảnh CCCD</label>
                        <input id="citizenImage" name="image" type="file" class="form-control" accept="image/*" required />
                    </div>
                    <div class="col-lg-2 col-md-12">
                        <button type="submit" class="btn btn-dark w-100">Nhận diện</button>
                    </div>
                </form>
                <div class="form-text mb-4">API test: <code>/api/admin/citizen-id/detect-side</code> (multipart/form-data).</div>

                <div class="data-card__header px-0">
                    <div>
                        <h2 class="data-card__title">Kết quả</h2>
                        <p class="data-card__subtitle">Kết quả raw JSON từ OpenAI để team dễ debug và hậu kiểm nghiệp vụ.</p>
                    </div>
                </div>
                <div id="detectStatus" class="text-secondary mb-3">Chưa có kết quả. Hãy upload ảnh và bấm Nhận diện.</div>
                <pre class="api-block api-block--light mb-0"><code id="detectResult">{ }</code></pre>
            </div>

            <div class="tab-pane fade" id="citizen-ocr-test" role="tabpanel" aria-labelledby="citizen-ocr-test-tab" tabindex="0">
                <form id="citizenIdOcrForm" class="row g-3 align-items-end mb-3">
                    <div class="col-lg-10 col-md-12">
                        <label class="form-label" for="citizenOcrImage">Ảnh CCCD</label>
                        <input id="citizenOcrImage" name="image" type="file" class="form-control" accept="image/*" required />
                    </div>
                    <div class="col-lg-2 col-md-12">
                        <button type="submit" class="btn btn-outline-dark w-100">OCR</button>
                    </div>
                </form>
                <div class="form-text mb-4">API test: <code>/api/admin/citizen-id/extract-ocr</code> (multipart/form-data).</div>

                <div class="data-card__header px-0">
                    <div>
                        <h2 class="data-card__title">Kết quả OCR</h2>
                        <p class="data-card__subtitle">OCR CCCD qua OpenAI, chuẩn hóa field để tích hợp API và hậu kiểm.</p>
                    </div>
                </div>
                <div id="ocrStatus" class="text-secondary mb-3">Chưa có kết quả. Hãy upload ảnh và bấm OCR.</div>
                <pre class="api-block api-block--light mb-0"><code id="ocrResult">{ }</code></pre>
            </div>

            <div class="tab-pane fade" id="citizen-combined-test" role="tabpanel" aria-labelledby="citizen-combined-test-tab" tabindex="0">
                <form id="citizenIdCombinedForm" class="row g-3 align-items-end mb-3">
                    <div class="col-lg-10 col-md-12">
                        <label class="form-label" for="citizenCombinedImage">Ảnh CCCD</label>
                        <input id="citizenCombinedImage" name="image" type="file" class="form-control" accept="image/*" required />
                    </div>
                    <div class="col-lg-2 col-md-12">
                        <button type="submit" class="btn btn-primary w-100">Nhận diện + OCR</button>
                    </div>
                </form>
                <div class="form-text mb-4">API test: <code>/api/admin/citizen-id/detect-and-ocr</code> (1 lần gọi trả cả detect và OCR).</div>

                <div class="data-card__header px-0">
                    <div>
                        <h2 class="data-card__title">Kết quả gộp</h2>
                        <p class="data-card__subtitle">Một request trả đồng thời side detection và OCR để tích hợp nhanh cho đối tác.</p>
                    </div>
                </div>
                <div id="combinedStatus" class="text-secondary mb-3">Chưa có kết quả. Hãy upload ảnh và bấm Nhận diện + OCR.</div>
                <pre class="api-block api-block--light mb-0"><code id="combinedResult">{ }</code></pre>
            </div>

            <div class="tab-pane fade" id="citizen-detect-doc" role="tabpanel" aria-labelledby="citizen-detect-doc-tab" tabindex="0">
                <div class="alert alert-light border mb-4" role="alert">
                    <strong>Mục tiêu:</strong> API này giúp nhận biết ảnh đang là mặt trước hay mặt sau CCCD để định tuyến xử lý đúng bước tiếp theo.
                </div>

                <h2 class="h5 mb-3">Công nghệ sử dụng (OpenAI Vision)</h2>
                <ul class="mb-4">
                    <li><strong>OpenAI Responses API:</strong> backend gửi ảnh đã chuẩn hóa tới <code>/v1/responses</code> để nhận diện mặt trước/sau và OCR CCCD.</li>
                    <li><strong>Schema output cố định:</strong> ép model trả JSON có cấu trúc để giảm sai khác định dạng giữa các lần gọi.</li>
                    <li><strong>Fused confidence:</strong> kết hợp confidence model với độ đầy đủ trường bắt buộc để xác định <code>success</code> hoặc <code>needs_review</code>.</li>
                    <li><strong>Hậu kiểm nghiệp vụ:</strong> trả <code>reasons</code> và cờ cần review để vận hành an toàn với dữ liệu giấy tờ.</li>
                </ul>

                <h2 class="h5 mb-3">Pipeline nhận diện (chi tiết)</h2>
                <ol class="mb-4">
                    <li><strong>Bước 1 - Nạp ảnh:</strong> nhận ảnh multipart và chuẩn hóa thành ma trận pixel RGB.</li>
                    <li><strong>Bước 2 - Tính ngưỡng mực động:</strong> lấy độ sáng trung bình toàn ảnh và nội suy ngưỡng mực để chịu được nhiều điều kiện ánh sáng.</li>
                    <li><strong>Bước 3 - Trích xuất đặc trưng:</strong>
                        <ul>
                            <li>Skin ratio (left/center/right) theo không gian màu YCbCr để bắt tín hiệu chân dung.</li>
                            <li>Ink density theo từng vùng để nhận dạng khu vực nhiều chữ.</li>
                            <li>MRZ-like band strength ở dải đáy để nhận diện mặt sau.</li>
                            <li>QR-like pattern ở nửa phải dưới dựa trên cân bằng đậm/nhạt + tần suất chuyển mức sáng.</li>
                            <li>Các tín hiệu bố cục như <code>frontPhotoLayoutLike</code>, <code>textHeavyBothSides</code>, <code>uniformTextDistribution</code>.</li>
                        </ul>
                    </li>
                    <li><strong>Bước 4 - Chấm điểm luật:</strong> mỗi đặc trưng cộng/trừ trọng số cho front/back; tín hiệu mạnh như QR hoặc MRZ sẽ đẩy về back, tín hiệu chân dung rõ sẽ đẩy về front.</li>
                    <li><strong>Bước 5 - Ra quyết định:</strong> so sánh chênh lệch điểm. Nếu sát nhau và độ mạnh chưa đủ thì trả <code>unknown</code> để tránh phân loại sai.</li>
                    <li><strong>Bước 6 - Tính confidence:</strong> confidence tăng theo độ chênh điểm và độ mạnh tín hiệu tổng, sau đó chuẩn hóa về khoảng 0-1.</li>
                </ol>

                <h2 class="h5 mb-3">Nguyên tắc phân tích thuật toán</h2>
                <ul class="mb-4">
                    <li>Ưu tiên <strong>độ tin cậy</strong> hơn ép buộc dự đoán: tín hiệu yếu hoặc mâu thuẫn sẽ trả <code>unknown</code>.</li>
                    <li>Dùng <strong>nhiều feature bổ trợ</strong> thay vì phụ thuộc một dấu hiệu đơn lẻ để giảm bias.</li>
                    <li>Cho phép <strong>tuning prompt/rule</strong> nhanh thông qua reasons và mẫu dữ liệu thực tế.</li>
                    <li>Thiết kế theo hướng <strong>giải thích được</strong>, phù hợp vận hành nội bộ và audit nghiệp vụ.</li>
                </ul>

                <h2 class="h5 mb-3">Sơ đồ quyết định (BA/QC)</h2>
                <p class="text-secondary mb-2">Luồng quyết định rút gọn để kiểm thử nhanh theo từng nhóm tín hiệu:</p>
                <pre class="api-block api-block--light mb-4"><code>Start
    -> Trích xuất tín hiệu nhận diện
  -> Tính frontScore và backScore
  -> maxScore đủ mạnh?
      - Không: side = unknown
      - Có: scoreGap đủ lớn?
          - Không: side = unknown
          - Có: side = score cao hơn (front/back)
    -> Tính confidence + trả reasons</code></pre>

                <div class="table-responsive mb-4">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th style="min-width: 280px;">Điều kiện chính</th>
                                <th style="min-width: 170px;">Tác động điểm</th>
                                <th>Mục đích nghiệp vụ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>qrDetected = true</code></td>
                                <td>Tăng mạnh <code>backScore</code></td>
                                <td>Ưu tiên mặt sau khi có tín hiệu QR-like rõ ràng.</td>
                            </tr>
                            <tr>
                                <td><code>mrzBandStrength</code> cao</td>
                                <td>Tăng <code>backScore</code></td>
                                <td>Mặt sau thường có dải text đáy đậm và liên tục.</td>
                            </tr>
                            <tr>
                                <td><code>portraitLikeDetected = true</code></td>
                                <td>Tăng <code>frontScore</code></td>
                                <td>Mặt trước có vùng chân dung dễ nhận diện hơn.</td>
                            </tr>
                            <tr>
                                <td><code>frontPhotoLayoutLike = true</code></td>
                                <td>Tăng <code>frontScore</code></td>
                                <td>Bố cục trái-phải giống ảnh chân dung + text mặt trước.</td>
                            </tr>
                            <tr>
                                <td><code>textHeavyBothSides = true</code> và <code>uniformTextDistribution = true</code></td>
                                <td>Tăng <code>backScore</code></td>
                                <td>Khi chữ dày và đều hai bên, nghiêng về mặt sau.</td>
                            </tr>
                            <tr>
                                <td>Không có chân dung rõ nhưng có MRZ/text đáy</td>
                                <td>Giảm thiên lệch <code>frontScore</code></td>
                                <td>Chống nhận nhầm front trong trường hợp ảnh sau nhiều chữ.</td>
                            </tr>
                            <tr>
                                <td><code>maxScore</code> thấp hoặc <code>scoreGap</code> nhỏ</td>
                                <td>Trả <code>unknown</code></td>
                                <td>Tránh quyết định sai khi tín hiệu chưa đủ chắc chắn.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <h2 class="h5 mb-3">Lưu ý khi dùng ảnh test</h2>
                <ul class="mb-4">
                    <li>Ảnh nên rõ nét, không rung, không che mất nội dung chính của thẻ.</li>
                    <li>Giữ thẻ nằm ngang, đủ sáng và hạn chế lóa.</li>
                    <li>Nếu kết quả là <code>unknown</code>, nên thử lại bằng ảnh rõ hơn.</li>
                </ul>

                <h2 class="h5 mb-3">Mô tả response (chi tiết)</h2>
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th style="min-width: 220px;">Trường</th>
                                <th style="min-width: 140px;">Kiểu dữ liệu</th>
                                <th>Mô tả</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>side</code></td>
                                <td>string</td>
                                <td>Kết quả phân loại: <code>front</code>, <code>back</code> hoặc <code>unknown</code>.</td>
                            </tr>
                            <tr>
                                <td><code>confidence</code></td>
                                <td>number</td>
                                <td>Mức độ tự tin của kết quả, giá trị từ 0 đến 1.</td>
                            </tr>
                            <tr>
                                <td><code>reasons</code></td>
                                <td>string[]</td>
                                <td>Danh sách giải thích các rule đã kích hoạt trong lần phân loại.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <h2 class="h5 mb-3">Ví dụ response</h2>
                <pre class="api-block api-block--light mb-0"><code>{
  "side": "back",
  "confidence": 0.872,
  "reasons": [
    "Vùng đáy có cấu trúc dải ký tự dày (MRZ-like), ưu tiên mặt sau.",
    "Không có dấu hiệu chân dung và mật độ text đồng đều ở vùng giữa, tăng ưu tiên mặt sau."
    ]
}</code></pre>
            </div>

                        <div class="tab-pane fade" id="citizen-api-doc" role="tabpanel" aria-labelledby="citizen-api-doc-tab" tabindex="0">
                                <h2 class="h5 mb-3">1. API admin nội bộ</h2>
                                <div class="integration-guide__chips mb-3">
                                        <span class="request-chip request-chip--post">POST</span>
                                        <span class="request-chip">/api/admin/citizen-id/detect-and-ocr</span>
                                </div>
                                <pre class="api-block mb-3"><code>curl -X POST "http://localhost:5137/api/admin/citizen-id/detect-and-ocr" \
    -H "Cookie: .AspNetCore.Cookies=YOUR_ADMIN_SESSION_COOKIE" \
    -F "image=@@cccd.jpg"</code></pre>

                                <h2 class="h5 mb-3">2. API partner tích hợp</h2>
                                <div class="integration-guide__chips mb-3">
                                        <span class="request-chip request-chip--post">POST</span>
                                        <span class="request-chip">/api/partner/citizen-id/detect-and-ocr</span>
                                </div>
                                <pre class="api-block mb-3"><code>curl -X POST "http://localhost:5137/api/partner/citizen-id/detect-and-ocr" \
    -H "X-Api-Key: YOUR_PARTNER_API_KEY" \
    -F "image=@@cccd.jpg"</code></pre>

                                <h2 class="h5 mb-3">3. Mẫu response gộp</h2>
                                <pre class="api-block api-block--light mb-3"><code>{
    "applied": true,
    "status": "success",
    "message": "Nhận diện + OCR CCCD thành công.",
    "detect": {
        "side": "front",
        "confidence": 0.91,
        "reasons": ["OpenAI đã phân tích ảnh CCCD."]
    },
    "ocr": {
        "applied": true,
        "status": "success",
        "message": "OCR CCCD thành công.",
        "rawText": "...",
        "confidence": 0.9,
        "fields": {
            "id_number": "012345678901",
            "full_name": "NGUYEN VAN A",
            "date_of_birth": "01/01/1990"
        },
        "lines": []
    }
}</code></pre>

                                <div class="alert alert-warning mb-0" role="alert">
                                        <strong>Lưu ý:</strong> khi <code>ocr.status = needs_review</code> hoặc <code>detect.side = unknown</code>, cần hậu kiểm thủ công trước khi ghi nhận nghiệp vụ.
                                </div>
                        </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function bindForm(formId, imageId, statusId, outputId, endpoint, pendingText, successText) {
                var form = document.getElementById(formId);
                if (!form) {
                    return;
                }

                var status = document.getElementById(statusId);
                var output = document.getElementById(outputId);

                form.addEventListener("submit", function (event) {
                    event.preventDefault();

                    var imageInput = document.getElementById(imageId);
                    if (!imageInput || !imageInput.files || imageInput.files.length === 0) {
                        status.textContent = "Vui lòng chọn ảnh CCCD trước khi gửi.";
                        return;
                    }

                    var formData = new FormData(form);
                    status.textContent = pendingText;

                    fetch(endpoint, {
                        method: "POST",
                        body: formData,
                        credentials: "same-origin"
                    })
                        .then(function (response) {
                            return response.text().then(function (raw) {
                                var body;
                                try {
                                    body = raw ? JSON.parse(raw) : {};
                                }
                                catch {
                                    body = { raw: raw };
                                }

                                if (!response.ok) {
                                    throw {
                                        status: response.status,
                                        statusText: response.statusText,
                                        body: body
                                    };
                                }

                                return body;
                            });
                        })
                        .then(function (result) {
                            status.textContent = successText;
                            output.textContent = JSON.stringify(result, null, 2);
                        })
                        .catch(function (error) {
                            var statusPrefix = error && error.status
                                ? ("Gọi API thất bại (HTTP " + error.status + ").")
                                : "Gọi API thất bại.";
                            status.textContent = statusPrefix;
                            output.textContent = JSON.stringify(error, null, 2);
                        });
                });
            }

            bindForm(
                "citizenIdDetectForm",
                "citizenImage",
                "detectStatus",
                "detectResult",
                "/api/admin/citizen-id/detect-side",
                "Đang gọi API nhận diện...",
                "Nhận diện thành công.");

            bindForm(
                "citizenIdOcrForm",
                "citizenOcrImage",
                "ocrStatus",
                "ocrResult",
                "/api/admin/citizen-id/extract-ocr",
                "Đang gọi API OCR...",
                "OCR thành công.");

            bindForm(
                "citizenIdCombinedForm",
                "citizenCombinedImage",
                "combinedStatus",
                "combinedResult",
                "/api/admin/citizen-id/detect-and-ocr",
                "Đang gọi API gộp detect + OCR...",
                "Nhận diện + OCR thành công.");
        })();
    </script>
}
